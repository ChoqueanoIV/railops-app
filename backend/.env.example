# Copie para backend/.env e substitua somente no ambiente local.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/railops
JWT_SECRET_KEY=substitua-por-um-segredo-com-32-bytes-ou-mais

# Valores permitidos: development, test, production
RAILOPS_ENV=development
API_TITLE=RailOps API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
